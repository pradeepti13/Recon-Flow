# Settlement Intelligence Environment Configuration

# LLM Provider: "gemini" or "groq"
LLM_PROVIDER=gemini

# API Keys (Provide at least one if LLM features are enabled)
GEMINI_API_KEY=
GROQ_API_KEY=

# LLM Models
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Data Paths
GATEWAY_DATA_PATH=data/gateway.csv
BANK_DATA_PATH=data/bank.csv
LEDGER_DATA_PATH=data/ledger.csv
DEMO_CASES_PATH=data/demo_cases.json
